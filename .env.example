# ==============================================================================
# AutoDB Environment Configuration
# ==============================================================================

# Public Domain / Base URL for magic verification links and SEO canonical tags
NEXT_PUBLIC_APP_URL=https://autodb.tech

# Community Discord Server URL (shown in global footer)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/autodb

# Administrator Secret Key (used to author/edit vehicles in /studio)
ADMIN_SECRET_KEY=autodb-secret-key-2025

# ==============================================================================
# Email Verification Configuration (SMTP)
# ==============================================================================
# In Development / Local mode (when these are left blank or unset):
# AutoDB automatically outputs verification codes & magic links to your
# terminal console and auto-fills them in the profile UI for instant testing.
#
# To dispatch actual emails to contributors in production, configure your SMTP below:

# --- Option A: Gmail (Requires 2FA & 16-character App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="AutoDB Verification" <yourname@gmail.com>

# --- Option B: Resend (Recommended for cloud/custom domains) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# SMTP_FROM="AutoDB Verification" <verify@autodb.tech>

# --- Option C: SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
# SMTP_FROM="AutoDB Verification" <verify@autodb.tech>
